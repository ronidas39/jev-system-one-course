# Copy this file to .env and put your own keys after the = sign.
# .env is listed in .gitignore, so git will never commit it.
# Never paste a key into a .py file.

# From https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# From https://platform.openai.com/api-keys (only needed for the comparisons)
OPENAI_API_KEY=
